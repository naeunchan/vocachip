# Copy to .env.release for Apps in Toss release candidates.
# Shell-provided env vars still take precedence over this file.
APP_ENV=production

# Apps in Toss identity
AIT_APP_NAME=replace-with-apps-in-toss-name
AIT_DISPLAY_NAME=replace-with-review-display-name
AIT_APP_ICON_URL=https://cdn.example.com/vocachip/icon-1024.png
AIT_PRIMARY_COLOR=#1d4ed8

# Hosted legal URLs
VOCACHIP_PRIVACY_POLICY_URL=https://vocachip.app/legal/privacy
VOCACHIP_TERMS_OF_SERVICE_URL=https://vocachip.app/legal/terms

# First-launch scope: guest-first mini app
VOCACHIP_FEATURE_ACCOUNT_AUTH=false
VOCACHIP_FEATURE_GUEST_ACCOUNT_CTA=false
VOCACHIP_FEATURE_BACKUP_RESTORE=false
VOCACHIP_FEATURE_REVIEW_LOOP=false
VOCACHIP_FEATURE_REVIEW_HOME_DASHBOARD=false
VOCACHIP_FEATURE_REVIEW_SESSION_UI=false
VOCACHIP_FEATURE_DAILY_GOAL=false
VOCACHIP_FEATURE_REVIEW_REMINDER=false
VOCACHIP_FEATURE_COLLECTIONS=false
VOCACHIP_FEATURE_FAVORITES_BATCH_ACTIONS=false
VOCACHIP_FEATURE_AI_STUDY_MODE=false
VOCACHIP_FEATURE_AI_STUDY_ENTRY_POINTS=false
VOCACHIP_FEATURE_AI_STUDY_SESSION_UI=false

# AI proxy
VOCACHIP_OPENAI_PROXY_URL=
VOCACHIP_OPENAI_PROXY_KEY=
VOCACHIP_AI_HEALTH_URL=
VOCACHIP_SENTRY_DSN=

# Server runtime
NODE_ENV=production
PORT=4000
AI_PROXY_KEY=
OPENAI_API_KEY=

# Optional extra browser origins for the proxy
CORS_ORIGINS=
