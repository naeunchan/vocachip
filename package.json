{
    "name": "vocachip",
    "version": "1.0.0",
    "main": "index.ts",
    "scripts": {
        "dev": "APP_ENV=development granite dev",
        "build": "APP_ENV=production ait build",
        "start": "npm run dev",
        "test": "jest",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "lint:pre-commit": "eslint . --ext .js,.jsx,.ts,.tsx --fix --max-warnings=1000",
        "format": "prettier --write .",
        "release:validate": "node scripts/release/validate-release-config.js",
        "ai:metrics:check": "node scripts/ops/check-ai-metrics.js",
        "ci:build": "CI=1 APP_ENV=production ait build",
        "proxy": "node server/index.js",
        "prepare": "husky || true"
    },
    "dependencies": {
        "@apps-in-toss/framework": "2.4.1",
        "@granite-js/native": "1.0.10",
        "@granite-js/plugin-env": "1.0.10",
        "@granite-js/react-native": "1.0.10",
        "@hookform/resolvers": "^5.2.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-navigation/bottom-tabs": "^7.15.9",
        "@react-navigation/native": "^7.2.2",
        "@react-navigation/native-stack": "^7.14.10",
        "@sentry/cli": "^3.3.5",
        "@sentry/react-native": "^8.7.0",
        "@toss/tds-react-native": "2.0.2",
        "brick-module": "0.5.0",
        "cors": "^2.8.6",
        "crypto-js": "^4.2.0",
        "dotenv": "^17.4.0",
        "express": "^5.2.1",
        "npm-check-updates": "^19.2.0",
        "openai": "^6.33.0",
        "quick-lru": "^7.3.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.72.1",
        "react-native": "0.84.0",
        "react-native-gesture-handler": "2.30.0",
        "react-native-safe-area-context": "5.6.2",
        "react-native-screens": "4.23.0",
        "react-native-svg": "^15.15.3",
        "react-native-web": "^0.21.2",
        "tslib": "^2.8.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/eslintrc": "^3.3.5",
        "@react-native/metro-config": "0.84.0",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "30.0.0",
        "@types/react": "19.2.3",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-preset-granite": "1.0.10",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-universe": "^15.0.3",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jest": "~30.2.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "react-test-renderer": "19.2.3",
        "typescript": "~5.9.3"
    },
    "jest": {
        "preset": "react-native",
        "setupFiles": [
            "<rootDir>/jest.setup-env.js"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.ts"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(@react-native|react-native|@react-navigation|@testing-library|@react-native-community|@apps-in-toss|@granite-js|@toss)/)"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts?(x)"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    },
    "private": true,
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml}": [
            "prettier --write"
        ]
    },
    "resolutions": {
        "tslib": "2.8.1"
    }
}
