# Server-only OpenAI settings.
# Copy this file to .env.local for local testing, and configure the same keys
# in your backend/serverless hosting dashboard for production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DICTIONARY_API_KEY=
DICTIONARY_API_REFERENCE=collegiate

# Local backend API server settings used by `npm run dev:api`.
AI_API_PORT=8787
AI_API_HOST=127.0.0.1
AI_ALLOWED_ORIGIN=http://127.0.0.1:5173
API_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30
DICTIONARY_RATE_LIMIT_MAX=120

# Frontend endpoint overrides are optional.
# Use same-origin paths when using the Vite proxy locally.
VITE_AI_MEANING_ENDPOINT=https://vocationary.onrender.com/api/ai/meanings
VITE_AI_EXAMPLE_ENDPOINT=https://vocationary.onrender.com/api/ai/example
VITE_DICTIONARY_ENDPOINT=https://vocationary.onrender.com/api/dictionary/search
VITE_AI_PROXY_TARGET=http://127.0.0.1:8787
VITE_FEEDBACK_EMAIL=

# Search smoke test endpoint used by `npm run test:search`.
DICTIONARY_TEST_ENDPOINT=http://127.0.0.1:8787/api/dictionary/search
